rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Araç fotoğrafları ve belgeleri: herkes okur, yalnızca yönetici yükler
    match /vehicles/{vehicleId}/images/{file} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
    match /vehicles/{vehicleId}/documents/{file} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 25 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    match /site/{file} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 5 * 1024 * 1024;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
